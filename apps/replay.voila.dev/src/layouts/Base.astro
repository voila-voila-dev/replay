---
// The shell of every page: @voila.dev/site's Base, with replay's structured data and styles.
import Shell from "@voila.dev/site/components/Base.astro";
import { repo, siteName } from "../data/site";
import "../styles/replay.css";

interface Props {
	title: string;
	description: string;
	home?: boolean;
}

const { title, description, home = false } = Astro.props;

const software = {
	"@context": "https://schema.org",
	"@type": "SoftwareSourceCode",
	name: siteName,
	description,
	url: "https://replay.voila.dev",
	codeRepository: repo,
	programmingLanguage: ["TypeScript"],
	license: "https://opensource.org/licenses/MIT",
	author: { "@type": "Organization", name: "Voila Development", url: "https://voila.dev" },
};
---

<Shell title={title} description={description} siteName={siteName} jsonLd={home ? software : undefined}>
	<Fragment slot="head">
		<!-- Cookie-free analytics (analytics.voila.dev) -->
		<script is:inline defer src="https://lumen.voila.dev/s.js" data-property="__ANALYTICS_PROPERTY_REPLAY_VOILA_DEV__"></script>
	</Fragment>
	<slot />
</Shell>
