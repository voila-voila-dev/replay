---
import Badges from "@voila.dev/site/components/Badges.astro";
import CodeBlock from "@voila.dev/site/components/CodeBlock.astro";
import FeatureGrid from "@voila.dev/site/components/FeatureGrid.astro";
import Fixes from "@voila.dev/site/components/Fixes.astro";
import Marquee from "@voila.dev/site/components/Marquee.astro";
import Section from "@voila.dev/site/components/Section.astro";
import Steps from "@voila.dev/site/components/Steps.astro";
import Versus from "@voila.dev/site/components/Versus.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
import Live from "../components/Live.astro";
import Top from "../components/Top.astro";
import { headline, sizes } from "../data/bench";
import { features } from "../data/features";
import { fixes, marquee, statuses, steps } from "../data/home";
import { browsers, npm, repo, version } from "../data/site";
import { playSnippet, recordSnippet } from "../data/snippets";
import Base from "../layouts/Base.astro";

const maxKb = Math.max(sizes.rrweb.record, sizes.replay.send);
---

<Base
	home
	title="replay · session replay that stays out of the way"
	description={`replay records what your visitors see and plays it back, node by node. ${sizes.replay.send} KB gzip with sending, ${headline.startRatio}× shorter start than rrweb, masked by default, honest about holes. Open source, MIT.`}
>
	<div class="in first-screen">
		<Top />
		<div class="hero">
			<h1 class="word">replay</h1>
			<Live compact stats={false} />
			<div class="under">
				<p>See what your visitors saw. Without slowing them down.</p>
				<div><span class="k">For</span>Product teams, support, developers</div>
				<div><span class="k">Status</span><a href={npm}>v{version} on npm ↗</a></div>
			</div>
		</div>
	</div>

	<Marquee items={marquee} />

	<main class="in">
		<Section id="why" title="Why" tag="What a session recorder should not do">
			<Fixes name="replay" rows={fixes} statuses={statuses} />
		</Section>

		<Section id="lighter" title="Lighter" tag="Same pages, same masking, same browser">
			<div class="thousand">
				<span class="n">{headline.startRatio}×</span>
				<p>shorter freeze than rrweb when recording starts, on {headline.page}.</p>
			</div>
			<Versus
				rows={[
					{ name: "replay", share: sizes.replay.send / maxKb, label: `${sizes.replay.send} KB gzip · record + send`, ours: true },
					{ name: "rrweb", share: sizes.rrweb.record / maxKb, label: `${sizes.rrweb.record} KB gzip · record only` },
				]}
			/>
			<a class="btn more" href="/benchmark">See the full benchmark →</a>
		</Section>

		<Section id="install" title="How" tag="Three calls">
			<Steps items={steps} />
			<div class="arch-grid code-grid">
				<CodeBlock code={recordSnippet} />
				<CodeBlock code={playSnippet} />
			</div>
			<Badges
				items={[
					{ href: repo, label: "100% open source · MIT" },
					{ href: npm, label: "Zero dependencies" },
					{ href: "/docs/browsers", label: `${browsers.join(" · ")} and later` },
				]}
			/>
		</Section>

		<Section id="features" title="Features" tag={`${features.length} of them, all in the box`}>
			<FeatureGrid items={features} />
			<div class="ctas more">
				<a class="btn" href="/docs">Read the docs →</a><a class="btn" href="/demos">Try every demo →</a><a class="btn" href="/playground"
					>Record a Wikipedia page →</a
				>
			</div>
		</Section>

		<Cta />
	</main>
	<div class="in"><Footer /></div>
</Base>
