---
import DemoPage from "../../layouts/DemoPage.astro";
---

<DemoPage title="Draw">
	<style is:global slot="head">
		header { display: flex; justify-content: space-between; align-items: center }
		.tools { display: flex; gap: 8px; align-items: center }
		.swatch { width: 26px; height: 26px; border-radius: 50%; border: 2px solid #fff; box-shadow: 0 0 0 1px #d9d9d4 }
		.swatch[aria-pressed="true"] { box-shadow: 0 0 0 2px #0c0c0e }
		canvas { flex: 1; width: 100%; min-height: 0; border: 1px dashed #c4c4be; border-radius: 12px; touch-action: none; cursor: crosshair; display: block }
	</style>
	<header>
		<h1>Sketch</h1>
		<div class="tools">
			<button class="swatch" data-color="#2633ff" style="background:#2633ff" aria-pressed="true" aria-label="Blue"></button>
			<button class="swatch" data-color="#e5484d" style="background:#e5484d" aria-label="Red"></button>
			<button class="swatch" data-color="#1fbf75" style="background:#1fbf75" aria-label="Green"></button>
			<stroke-count id="count"></stroke-count>
		</div>
	</header>
	<canvas width="1000" height="560"></canvas>
	<script is:inline>
		// A counter in a shadow root: recorded by the shadow() module.
		customElements.define("stroke-count", class extends HTMLElement {
			constructor() { super(); this.attachShadow({ mode: "open" }).innerHTML = `<style>span{display:inline-flex;padding:4px 10px;border-radius:999px;background:#f1f1ec;font:600 12px system-ui}</style><span>0 strokes</span>`; }
			set value(n) { this.shadowRoot.querySelector("span").textContent = `${n} stroke${n === 1 ? "" : "s"}`; }
		});
		const canvas = document.querySelector("canvas");
		const ctx = canvas.getContext("2d");
		ctx.lineWidth = 6; ctx.lineCap = "round"; ctx.lineJoin = "round"; ctx.strokeStyle = "#2633ff";
		let last = null, strokes = 0;
		const at = (e) => { const r = canvas.getBoundingClientRect(); return [((e.clientX - r.left) / r.width) * canvas.width, ((e.clientY - r.top) / r.height) * canvas.height]; };
		canvas.addEventListener("pointerdown", (e) => (last = at(e)));
		canvas.addEventListener("pointermove", (e) => { if (!last) return; const p = at(e); ctx.beginPath(); ctx.moveTo(...last); ctx.lineTo(...p); ctx.stroke(); last = p; });
		for (const t of ["pointerup", "pointerleave"]) canvas.addEventListener(t, () => { if (last) document.getElementById("count").value = ++strokes; last = null; });
		for (const b of document.querySelectorAll(".swatch")) b.addEventListener("click", () => {
			for (const o of document.querySelectorAll(".swatch")) o.setAttribute("aria-pressed", String(o === b));
			ctx.strokeStyle = b.dataset.color;
		});
		window.clearSignature = () => { ctx.clearRect(0, 0, canvas.width, canvas.height); strokes = 0; document.getElementById("count").value = 0; };
	</script>
</DemoPage>
