---
import PageHero from "@voila.dev/site/components/PageHero.astro";
import Section from "@voila.dev/site/components/Section.astro";
import Toc from "@voila.dev/site/components/Toc.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
import Live from "../components/Live.astro";
import Top from "../components/Top.astro";
import { version } from "../data/site";
import Base from "../layouts/Base.astro";

const index = [
	{ id: "live", name: "Live", text: "A todo list, op by op" },
	{ id: "privacy", name: "Privacy", text: "A sign-up form" },
	{ id: "player", name: "Player", text: "A support chat" },
	{ id: "holes", name: "Holes", text: "A live dashboard" },
	{ id: "modules", name: "Modules", text: "A sketch pad" },
];
---

<Base
	title="replay demos · record and play back, live"
	description="Five small apps recorded by @voila.dev/replay and played back next to them, in your browser: a todo list, a sign-up form, a chat, a live dashboard, a sketch pad."
>
	<div class="in">
		<Top />
		<PageHero
			title="Demos"
			lead="Five small apps, recorded in your browser."
			facts={[
				{ label: "Left", value: "The app. Use it." },
				{ label: "Right", value: `Its copy, by @voila.dev/replay ${version}` },
			]}
		/>
		<Toc items={index} />
	</div>

	<main class="in">
		<Section id="live" title="Live" tag="The tape, op by op">
			<p class="claim lead">Add a task, tick it, delete it. Each change is a few ops.</p>
			<Live app="todo" tape />
		</Section>

		<Section id="privacy" title="Privacy" tag="Masked in the core">
			<p class="claim lead">The password and the card never leave the page. The balance is never read.</p>
			<Live app="signup" maskPicker />
		</Section>

		<Section id="player" title="Player" tag="Pause, speed, seek">
			<p class="claim lead">Rewind the conversation. Seeking starts from the nearest checkpoint.</p>
			<Live app="chat" controls stats={false} />
		</Section>

		<Section id="holes" title="Holes" tag="Said, not replayed">
			<p class="claim lead">Lose a chunk. The copy stops and says so, until the next snapshot.</p>
			<Live app="dashboard" drop controls />
		</Section>

		<Section id="modules" title="Modules" tag="Shadow DOM, canvas">
			<p class="claim lead">Draw. The canvas and the counter in its shadow root reach the copy.</p>
			<Live app="draw" modules={["cssom", "shadow", "canvas"]} />
		</Section>

		<Cta />
	</main>
	<div class="in"><Footer /></div>
</Base>
