{
	"name": "@voila.dev/replay",
	"version": "0.3.0",
	"description": "Session recording and replay for the web: a small recorder, a flat tape format, a DOM-built player.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voila-voila-dev/replay.git"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"LICENSE",
		"README.md"
	],
	"exports": {
		"./format": {
			"types": "./dist/format/index.d.ts",
			"default": "./dist/format.js"
		},
		"./record": {
			"types": "./dist/record/index.d.ts",
			"default": "./dist/record.js"
		},
		"./send": {
			"types": "./dist/send/index.d.ts",
			"default": "./dist/send.js"
		},
		"./play": {
			"types": "./dist/play/index.d.ts",
			"default": "./dist/play.js"
		},
		"./modules": {
			"types": "./dist/modules/index.d.ts",
			"default": "./dist/modules.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"default": "./dist/testing.js"
		}
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"typecheck": "tsc --noEmit",
		"test": "bun test test/unit",
		"test:browser": "node scripts/build.mjs && node test/browser/run.mjs",
		"size": "node scripts/build.mjs && node scripts/size.mjs",
		"prepack": "node scripts/build.mjs",
		"changeset": "changeset"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@changesets/changelog-github": "0.5.2",
		"@changesets/cli": "2.29.8",
		"esbuild": "0.25.12",
		"playwright": "1.61.1",
		"typescript": "5.9.3",
		"@types/bun": "1.3.3"
	}
}
